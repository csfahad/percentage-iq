{
    "manifest_version": 3,
    "name": "IGNOU Percentage IQ",
    "version": "1.0.0",
    "description": "Auto-calculates your IGNOU percentage from your Grade Card - right on the page.",
    "permissions": ["storage", "activeTab", "scripting"],
    "host_permissions": [
        "https://gradecard.ignou.ac.in/*",
        "http://gradecard.ignou.ac.in/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://gradecard.ignou.ac.in/*",
                "http://gradecard.ignou.ac.in/*"
            ],
            "js": [
                "content/calculator.js",
                "content/scraper.js",
                "content/ui.js",
                "content/content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "service_worker": "background/service_worker.js"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": "assets/icon.png"
    },
    "icons": {
        "128": "assets/icon.png"
    }
}
